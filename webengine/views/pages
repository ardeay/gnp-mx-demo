<div class="min-h-screen bg-slate-50 text-[#002E71]">

  <main class="pb-16">
    <section class="relative overflow-hidden">
      <div class="absolute inset-0">
        <img src="{{this.main_image.getImage()}}" alt="{{this.title}}" class="h-full w-full object-cover">
        <div class="absolute inset-0 bg-[#002E71]/70"></div>
      </div>
      <div class="relative mx-auto flex min-h-[420px] max-w-7xl items-end px-6 pb-12 pt-24 lg:min-h-[520px]">
        <div class="max-w-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.3em] text-white/70">GNP MX</p>
          <h1 class="mt-4 text-3xl font-semibold text-white sm:text-4xl lg:text-5xl">
            {{this.title}}
          </h1>
          <p class="mt-4 text-base text-white/80">
            Soluciones hechas para ti, con respaldo y atencion personalizada.
          </p>
        </div> 
      </div>
    </section>

    <section class="mx-auto mt-10 max-w-5xl px-6">
      <div class="rounded-3xl bg-white p-8 shadow-xl shadow-[#002E71]/10 sm:p-10">
        <div class="prose prose-slate max-w-none prose-headings:text-[#002E71] prose-a:text-[#F46826] prose-strong:text-[#002E71]">
          {{this.content}}
        </div>
      </div>
    </section>
  </main>

</div>
